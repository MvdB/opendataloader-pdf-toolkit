# Copy to .env (which is gitignored) and fill in.
# Used by pdf-toolkit-enrich and by docker-compose.vllm.yml.

# -- Enrichment LLM client --------------------------------------------------
# Point at any OpenAI-compatible endpoint: enterprise gateway, vLLM, Ollama, LM
# Studio, OpenAI itself. No silent fallback to a public cloud — the default
# below is just what the OpenAI SDK uses when unset.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=google/gemma-4-E2B-it
VLM_MODEL=google/gemma-4-E2B-it
# For --embed, point at an embedding endpoint (Gemma is not an embedder).
# Suggestion: run a separate container, e.g. Ollama `nomic-embed-text` or
# a dedicated vLLM with an embedding-trained model.
EMBEDDING_MODEL=

# -- docker-compose.vllm.yml knobs ------------------------------------------
# HF access for gated models (Gemma family is gated).
HUGGING_FACE_HUB_TOKEN=
# The model served by the vllm service.
VLLM_MODEL=google/gemma-4-E2B-it
# Tuning for tight VRAM (defaults shown are what we verified on an 8 GB RTX 4060).
VLLM_DTYPE=bfloat16
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=2
VLLM_GPU_UTIL=0.85
VLLM_KV_CACHE_DTYPE=fp8
